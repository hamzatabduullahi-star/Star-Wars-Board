}

// ========== RENDER CART PAGE ==========
function renderCartPage() {
  const container = document.getElementById("cartContent");
  if (!container) return;

  if (cart.length === 0) {
    container.innerHTML = `
      <div class="cart-empty-msg">
        <p>Your cart is empty</p>
        <a href="products.html" class="btn" style="margin-top:1.5rem;">Continue Shopping</a>
      </div>
    `;
    return;
  }

  let rows = cart.map(item => `
    <tr>
      <td>
        <strong>${item.emoji} ${item.name}</strong>
      </td>
      <td>$${item.price}</td>
      <td>
        <div class="qty-controls">
          <button class="qty-btn" onclick="changeQty(${item.id}, -1)">−</button>
          <span>${item.qty}</span>
          <button class="qty-btn" onclick="changeQty(${item.id}, 1)">+</button>
        </div>
      </td>
      <td>$${item.price * item.qty}</td>
      <td>
        <button class="remove-item" onclick="removeFromCart(${item.id})">Remove</button>
      </td>
    </tr>
  `).join("");

  const total = cart.reduce((sum, i) => sum + i.price * i.qty, 0);

  container.innerHTML = `
    <table class="cart-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Price</th>
          <th>Qty</th>
          <th>Subtotal</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        ${rows}
      </tbody>
    </table>

    <div class="cart-summary">
      <div class="cart-total-row">
        <span>Total</span>
        <span>$${total}</span>
      </div>
      <button class="checkout-btn" onclick="checkoutWhatsApp()">
        💬 Checkout via WhatsApp
      </button>
    </div>
  `;
}

// ========== WHATSAPP CHECKOUT ==========
function checkoutWhatsApp() {
  if (cart.length === 0) return;

  let message = "Hello! I would like to place an order from *Star Wars Galaxy Creations*:%0A%0A";

  cart.forEach(item => {
    message += `• ${item.name} x${item.qty} — $${item.price * item.qty}%0A`;
  });

  const total = cart.reduce((sum, i) => sum + i.price * i.qty, 0);
  message += `%0A*Total: $${total}*%0A%0APreferred payment method: (PayPal / Chime / Bitcoin / Bank Transfer / Card / Zelle / Gift Card)%0A%0AThank you!`;

  window.open(`https://wa.me/15162884763?text=${message}`, "_blank");
}

// ========== MOBILE MENU ==========
function initMobileMenu() {
  const toggle = document.getElementById("menuToggle");
  const nav = document.getElementById("mainNav");
  if (toggle && nav) {
    toggle.addEventListener("click", () => {
      nav.classList.toggle("open");
    });
  }
}

// ========== CATEGORY TABS ==========
function initCategoryTabs() {
  const tabs = document.querySelectorAll(".tab-btn");
  tabs.forEach(btn => {
    btn.addEventListener("click", () => {
      tabs.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      renderProducts(btn.dataset.category);
    });
  });
}

// ========== INIT ON PAGE LOAD ==========
document.addEventListener("DOMContentLoaded", () => {
  updateCartCount();
  initMobileMenu();
  initCategoryTabs();
  renderProducts();      // for products.html
  renderFeatured();      // for index.html
  renderCartPage();      // for cart.html
});
