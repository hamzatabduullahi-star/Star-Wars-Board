// ===================================
// PRODUCTS DATABASE
// ===================================
const products = [
    { id: 1, name: "Galaxy Resin Board", price: 120.00, emoji: "🪵" },
    { id: 2, name: "Death Star Board", price: 95.00, emoji: "🛸" },
    { id: 3, name: "Lightsaber Cutting Board", price: 140.00, emoji: "⚡" },
    { id: 4, name: "Custom Order", price: 150.00, emoji: "🎨" },
    { id: 5, name: "Millennium Falcon Board", price: 165.00, emoji: "🌌" },
    { id: 6, name: "Jedi Master Serving Set", price: 110.00, emoji: "🌟" }
];

// ===================================
// CART SYSTEM
// ===================================
let cart = JSON.parse(localStorage.getItem('starWarsCart')) || [];

function saveCart() {
    localStorage.setItem('starWarsCart', JSON.stringify(cart));
    updateCartUI();
}

// ===================================
// ADD TO CART
// ===================================
function addToCart(productId) {
    console.log('🛒 Adding product:', productId);
    
    const product = products.find(p => p.id === productId);
    if (!product) {
        console.error('❌ Product not found!');
        return;
    }

    const existing = cart.find(item => item.id === productId);
    if (existing) {
        existing.quantity += 1;
    } else {
        cart.push({
            id: product.id,
            name: product.name,
            price: product.price,
            emoji: product.emoji || '🪵',
            quantity: 1
        });
    }

    saveCart();
    console.log('✅ Cart after add:', cart);
    
    // Show notification
    showNotification(product);
}

// ===================================
// REMOVE FROM CART
// ===================================
function removeFromCart(productId) {
    const item = cart.find(i => i.id === productId);
    if (item) {
        cart = cart.filter(i => i.id !== productId);
        saveCart();
        showSimpleNotification(`🗑️ ${item.name} removed`);
    }
}

// ===================================
// UPDATE QUANTITY
// ===================================
function updateQuantity(productId, change) {
    const item = cart.find(i => i.id === productId);
    if (!item) return;

    const newQty = item.quantity + change;
    if (newQty <= 0) {
        removeFromCart(productId);
        return;
    }

    item.quantity = newQty;
    saveCart();
}

// ===================================
// ✅ PREMIUM NOTIFICATION (GUARANTEED TO WORK)
// ===================================
function showNotification(product) {
    // Remove any existing notification
    const existing = document.querySelector('.cart-notification');
    if (existing) existing.remove();

    // Create the notification
    const notif = document.createElement('div');
    notif.className = 'cart-notification';
    notif.innerHTML = `
        <div style="display: flex; align-items: center; gap: 14px; flex: 1;">
            <span style="font-size: 28px;">${product.emoji || '✅'}</span>
            <div>
                <div style="font-weight: 600; color: white; font-size: 16px;">${product.name}</div>
                <div style="color: #aaa; font-size: 13px;">Added to cart ✨</div>
            </div>
        </div>
        <button onclick="this.parentElement.remove()" style="
            background: none;
            border: none;
            color: #666;
            font-size: 20px;
            cursor: pointer;
            padding: 0 8px;
            transition: 0.3s;
            font-family: 'Poppins', sans-serif;
        ">✕</button>
    `;

    // Apply styles
    Object.assign(notif.style, {
        position: 'fixed',
        top: '100px',
        right: '20px',
        maxWidth: '400px',
        minWidth: '280px',
        background: 'rgba(11, 14, 20, 0.95)',
        backdropFilter: 'blur(16px)',
        WebkitBackdropFilter: 'blur(16px)',
        border: '1px solid #d4af37',
        borderRadius: '14px',
        padding: '16px 20px',
        color: '#ffffff',
        zIndex: '999999',
        boxShadow: '0 12px 50px rgba(0,0,0,0.9), 0 0 40px rgba(212,175,55,0.15)',
        fontFamily: "'Poppins', sans-serif",
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between',
        gap: '12px',
        transform: 'translateX(120%)',
        opacity: '0',
        transition: 'all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55)',
        pointerEvents: 'none',
        borderLeft: '4px solid #d4af37'
    });

    document.body.appendChild(notif);

    // Trigger slide in
    setTimeout(() => {
        notif.style.transform = 'translateX(0)';
        notif.style.opacity = '1';
        notif.style.pointerEvents = 'auto';
    }, 50);

    // Auto remove after 4 seconds
    setTimeout(() => {
        notif.style.transform = 'translateX(120%)';
        notif.style.opacity = '0';
        setTimeout(() => {
            if (notif.parentElement) notif.remove();
        }, 500);
    }, 4000);
}

