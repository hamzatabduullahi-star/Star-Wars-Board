// ===================================
// UPDATE CART UI
// ===================================
function updateCartUI() {
    // Update cart badge
    const countElements = document.querySelectorAll('.cart-count');
    const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
    
    countElements.forEach(el => {
        el.textContent = totalItems;
        if (totalItems > 0) {
            el.style.display = 'flex';
            el.style.background = '#e63946';
            el.style.color = 'white';
            el.style.width = '22px';
            el.style.height = '22px';
            el.style.borderRadius = '50%';
            el.style.alignItems = 'center';
            el.style.justifyContent = 'center';
            el.style.fontSize = '11px';
            el.style.fontWeight = '700';
        } else {
            el.style.display = 'none';
        }
    });

    // Cart page specific
    const cartContainer = document.getElementById('cart-items');
    const emptyMsg = document.getElementById('empty-cart');
    const summary = document.getElementById('cartSummary');
    const table = document.getElementById('cartTable');

    if (!cartContainer) return;

    if (cart.length === 0) {
        cartContainer.innerHTML = '';
        if (emptyMsg) emptyMsg.style.display = 'block';
        if (summary) summary.style.display = 'none';
        if (table) table.style.display = 'none';
        return;
    }

    if (emptyMsg) emptyMsg.style.display = 'none';
    if (summary) summary.style.display = 'block';
    if (table) table.style.display = 'table';

    cartContainer.innerHTML = cart.map(item => `
        <tr>
            <td>
                <div class="cart-product-info">
                    <span style="font-size: 30px;">${item.emoji || '🪵'}</span>
                    <span style="font-weight: 500;">${item.name}</span>
                </div>
            </td>
            <td>£${item.price.toFixed(2)}</td>
            <td>
                <div class="qty-controls">
                    <button class="qty-btn" onclick="updateQuantity(${item.id}, -1)" ${item.quantity <= 1 ? 'disabled' : ''}>−</button>
                    <span class="qty-number">${item.quantity}</span>
                    <button class="qty-btn" onclick="updateQuantity(${item.id}, 1)">+</button>
                </div>
            </td>
            <td>£${(item.price * item.quantity).toFixed(2)}</td>
            <td>
                <button class="remove-btn" onclick="removeFromCart(${item.id})">
                    <i class="fa-solid fa-trash"></i> Remove
                </button>
            </td>
        </tr>
    `).join('');

    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const subtotalEl = document.getElementById('cart-subtotal');
    const totalEl = document.getElementById('cart-total');
    if (subtotalEl) subtotalEl.textContent = `£${subtotal.toFixed(2)}`;
    if (totalEl) totalEl.textContent = `£${subtotal.toFixed(2)}`;
}

// ===================================
// EVENT LISTENERS
// ===================================
document.addEventListener('DOMContentLoaded', function() {
    console.log('🚀 Star Wars Galaxy Creations - Loaded!');

    // Mobile menu
    const menuToggle = document.getElementById('menuToggle');
    const nav = document.getElementById('mainNav') || document.getElementById('nav');

    if (menuToggle && nav) {
        menuToggle.addEventListener('click', function() {
            nav.classList.toggle('active');
            const icon = menuToggle.querySelector('i');
            if (icon) {
                icon.className = nav.classList.contains('active')
                    ? 'fa-solid fa-xmark'
                    : 'fa-solid fa-bars';
            }
        });
    }

    // Back to top
    const topBtn = document.getElementById('topBtn');
    if (topBtn) {
        window.addEventListener('scroll', function() {
            topBtn.style.display = window.scrollY > 400 ? 'flex' : 'none';
        });
        topBtn.addEventListener('click', function() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
        topBtn.style.display = 'none';
    }

    // ✅ ADD TO CART BUTTONS - DIRECT EVENT BINDING
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
        btn.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            const productId = parseInt(this.dataset.productId);
            console.log('🛒 Button clicked for product ID:', productId);
            if (productId) {
                addToCart(productId);
            } else {
                console.error('❌ No product ID found!');
            }
        });
    });

    // Close menu on link click
    document.querySelectorAll('nav a').forEach(link => {
        link.addEventListener('click', function() {
            if (nav && nav.classList.contains('active')) {
                nav.classList.remove('active');
                const icon = menuToggle?.querySelector('i');
                if (icon) icon.className = 'fa-solid fa-bars';
            }
        });
    });

    // Update cart on load
    updateCartUI();
});

// ===================================
// EXPOSE FUNCTIONS TO GLOBAL SCOPE
// ===================================
window.addToCart = addToCart;
window.removeFromCart = removeFromCart;
window.updateQuantity = updateQuantity;
window.showNotification = showNotification;

console.log('✅ Cart system ready!');
console.log(`📦 ${cart.length} items in cart`);
