// ===================================
// PRODUCTS DATABASE
// ===================================
const products = [
    { id: 1, name: "Galaxy Resin Board", price: 120.00, emoji: "🪵" },
    { id: 2, name: "Death Star Board", price: 95.00, emoji: "🛸" },
    { id: 3, name: "Lightsaber Cutting Board", price: 140.00, emoji: "⚡" },
    { id: 4, name: "Custom Order", price: 150.00, emoji: "🎨" },
    { id: 5, name: "Millennium Falcon Board", price: 165.00, emoji: "🌌" },
    { id: 6, name: "Jedi Master Serving Set", price: 110.00, emoji: "🌟" }
];

// ===================================
// LOAD CART
// ===================================
let cart = [];

// Try to load cart from localStorage
try {
    const saved = localStorage.getItem('starWarsCart');
    if (saved) {
        cart = JSON.parse(saved);
        console.log('📦 Cart loaded:', cart);
    }
} catch (e) {
    console.log('📦 No saved cart found, starting fresh');
    cart = [];
}

// ===================================
// SAVE CART
// ===================================
function saveCart() {
    try {
        localStorage.setItem('starWarsCart', JSON.stringify(cart));
        console.log('💾 Cart saved:', cart);
    } catch (e) {
        console.error('❌ Failed to save cart:', e);
    }
    updateCartUI();
}

// ===================================
// ADD TO CART
// ===================================
function addToCart(productId) {
    console.log('🛒 Adding product ID:', productId);
    
    // Find the product
    const product = products.find(p => p.id === productId);
    if (!product) {
        console.error('❌ Product not found!');
        alert('Product not found!');
        return;
    }

    console.log('📦 Product found:', product.name);

    // Check if already in cart
    const existing = cart.find(item => item.id === productId);
    if (existing) {
        existing.quantity += 1;
        console.log('➕ Quantity increased to:', existing.quantity);
    } else {
        cart.push({
            id: product.id,
            name: product.name,
            price: product.price,
            emoji: product.emoji || '🪵',
            quantity: 1
        });
        console.log('🆕 New item added to cart');
    }

    saveCart();
    
    // Show notification
    showNotification(product);
}

// ===================================
// REMOVE FROM CART
// ===================================
function removeFromCart(productId) {
    const item = cart.find(i => i.id === productId);
    if (item) {
        cart = cart.filter(i => i.id !== productId);
        saveCart();
        showSimpleNotification(`🗑️ ${item.name} removed`);
    }
}

// ===================================
// UPDATE QUANTITY
// ===================================
function updateQuantity(productId, change) {
    const item = cart.find(i => i.id === productId);
    if (!item) return;

    const newQty = item.quantity + change;
    if (newQty <= 0) {
        removeFromCart(productId);
        return;
    }

    item.quantity = newQty;
    saveCart();
}

// ===================================
// SHOW NOTIFICATION
// ===================================
function showNotification(product) {
    console.log('🔔 Showing notification for:', product.name);
    
    // Remove old notification
    const old = document.querySelector('.cart-notification');
    if (old) old.remove();

    // Create notification
    const notif = document.createElement('div');
    notif.className = 'cart-notification';
    notif.innerHTML = `
        <div style="display:flex;align-items:center;gap:12px;flex:1;">
            <span style="font-size:28px;">${product.emoji}</span>
            <div>
                <div style="font-weight:600;color:white;font-size:15px;">${product.name}</div>
                <div style="color:#aaa;font-size:12px;">Added to cart! ✨</div>
            </div>
        </div>
        <button onclick="this.parentElement.remove()" style="background:none;border:none;color:#666;font-size:20px;cursor:pointer;padding:0 8px;">✕</button>
    `;

    // Style the notification
    notif.style.cssText = `
        position: fixed;
        top: 100px;
        right: 20px;
        max-width: 380px;
        min-width: 250px;
        background: #0a0f1a;
        backdrop-filter: blur(16px);
        border: 1px solid #d4af37;
        border-radius: 14px;
        padding: 16px 20px;
        color: white;
        z-index: 999999;
        box-shadow: 0 12px 50px rgba(0,0,0,0.9), 0 0 40px rgba(212,175,55,0.15);
        font-family: 'Poppins', Arial, sans-serif;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        transform: translateX(120%);
        opacity: 0;
        transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
        pointer-events: none;
        border-left: 4px solid #d4af37;
    `;

    document.body.appendChild(notif);

    // Slide in
    setTimeout(() => {
        notif.style.transform = 'translateX(0)';
        notif.style.opacity = '1';
        notif.style.pointerEvents = 'auto';
    }, 50);

    // Auto remove after 4 seconds
    setTimeout(() => {
        notif.style.transform = 'translateX(120%)';
        notif.style.opacity = '0';
        setTimeout(() => {
            if (notif.parentElement) notif.remove();
        }, 500);
    }, 4000);
}

// ===================================
