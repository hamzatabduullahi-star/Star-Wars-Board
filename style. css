/* ====================================
   GOOGLE FONT & RESET
==================================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
font-family:'Poppins',sans-serif;
}

body{
background:#ffffff;
color:#222;
overflow-x:hidden;
transition:.4s;
}

body.dark{
background:#0d0d0d;
color:#fff;
}

a{
text-decoration:none;
color:inherit;
}

ul{
list-style:none;
}

img{
width:100%;
display:block;
}

.container{
width:90%;
max-width:1300px;
margin:auto;
}

/* ====================================
   NAVBAR
==================================== */

header{
position:fixed;
top:0;
left:0;
width:100%;
background:rgba(255,255,255,.95);
backdrop-filter:blur(12px);
z-index:999;
box-shadow:0 5px 15px rgba(0,0,0,.08);
transition:.4s;
}

body.dark header{
background:#111;
}

.navbar{
width:90%;
max-width:1300px;
margin:auto;
height:80px;
display:flex;
align-items:center;
justify-content:space-between;
}

.logo a{
font-size:30px;
font-weight:800;
letter-spacing:2px;
color:#000;
transition:.4s;
}

body.dark .logo a{
color:#fff;
}

.nav-links{
display:flex;
align-items:center;
gap:35px;
}

.nav-links a{
font-size:17px;
font-weight:600;
transition:.3s;
position:relative;
}

.nav-links a:hover{
color:#b8860b;
}

.nav-links a::after{
content:"";
position:absolute;
left:0;
bottom:-6px;
width:0;
height:2px;
background:#b8860b;
transition:.4s;
}

.nav-links a:hover::after{
width:100%;
}

.nav-buttons{
display:flex;
align-items:center;
gap:18px;
}

#dark-mode{
width:45px;
height:45px;
border:none;
border-radius:50%;
background:#111;
color:#fff;
cursor:pointer;
font-size:18px;
transition:.4s;
}

body.dark #dark-mode{
background:#fff;
color:#111;
}

.menu-btn{
display:none;
font-size:30px;
cursor:pointer;
}

/* ====================================
   HERO SECTION
==================================== */

.hero{
height:100vh;
background:
linear-gradient(rgba(0,0,0,.65),
rgba(0,0,0,.65)),
url("images/hero.jpg");
background-size:cover;
background-position:center;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:0 20px;
}

.hero-content{
max-width:900px;
color:#fff;
}

.slide-title{
font-size:70px;
font-weight:800;
letter-spacing:4px;
margin-bottom:25px;
animation:slideTitle 4s infinite alternate;
}

@keyframes slideTitle{

0%{
transform:translateX(-40px);
opacity:0;
}

100%{
transform:translateX(40px);
opacity:1;
}

}

.hero p{
font-size:22px;
line-height:1.8;
margin-bottom:35px;
}

.hero-buttons{
display:flex;
justify-content:center;
gap:20px;
flex-wrap:wrap;
}

.btn{
padding:15px 40px;
background:#b8860b;
color:#fff;
font-weight:700;
border-radius:50px;
transition:.4s;
}

.btn:hover{
background:#fff;
color:#111;
transform:translateY(-4px);
}

.btn-outline{
padding:15px 40px;
border:2px solid #fff;
color:#fff;
border-radius:50px;
font-weight:700;
transition:.4s;
}

.btn-outline:hover{
background:#fff;
color:#111;
}
