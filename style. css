/* ===========================
   Google Font & Reset
=========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
    font-family:'Poppins',sans-serif;
}

body{
    background:#ffffff;
    color:#222;
    overflow-x:hidden;
    transition:.4s;
}

img{
    width:100%;
    display:block;
}

a{
    text-decoration:none;
    color:inherit;
}

ul{
    list-style:none;
}

.container{
    width:90%;
    max-width:1200px;
    margin:auto;
}

/* ===========================
   Navigation
=========================== */

header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    background:#111;
    z-index:1000;
    box-shadow:0 3px 12px rgba(0,0,0,.2);
}

.navbar{
    width:90%;
    margin:auto;
    height:80px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo a{
    color:#FFD700;
    font-size:28px;
    font-weight:700;
    letter-spacing:2px;
}

.nav-links{
    display:flex;
    gap:30px;
}

.nav-links a{
    color:#fff;
    font-weight:500;
    transition:.3s;
}

.nav-links a:hover,
.nav-links .active{
    color:#FFD700;
}

.nav-buttons{
    display:flex;
    align-items:center;
    gap:20px;
}

#dark-mode{
    border:none;
    background:#FFD700;
    color:#111;
    width:45px;
    height:45px;
    border-radius:50%;
    cursor:pointer;
    font-size:18px;
}

.menu-btn{
    display:none;
    color:#fff;
    font-size:28px;
    cursor:pointer;
}

#cart-count{
    background:red;
    color:white;
    font-size:12px;
    border-radius:50%;
    padding:2px 7px;
    margin-left:4px;
}

/* ===========================
   Hero
=========================== */

.hero{
    height:100vh;
    background:linear-gradient(rgba(0,0,0,.65),
    rgba(0,0,0,.65)),
    url("images/hero.jpg") center/cover;
    display:flex;
    justify-content:center;
    align-items:center;
    text-align:center;
    padding:30px;
}

.hero-content{
    max-width:850px;
}

.slide-title{
    font-size:70px;
    color:#FFD700;
    margin-bottom:20px;
    animation:slideIn 2s ease;
}

.hero p{
    color:white;
    font-size:20px;
    line-height:1.8;
    margin-bottom:35px;
}

.hero-buttons{
    display:flex;
    justify-content:center;
    gap:20px;
    flex-wrap:wrap;
}

.btn{
    background:#FFD700;
    color:#111;
    padding:14px 35px;
    border-radius:40px;
    font-weight:600;
    transition:.3s;
}

.btn:hover{
    transform:translateY(-5px);
}

.btn-outline{
    border:2px solid #FFD700;
    color:#FFD700;
    padding:14px 35px;
    border-radius:40px;
    transition:.3s;
}

.btn-outline:hover{
    background:#FFD700;
    color:#111;
}
/*==============================
 SEARCH SECTION
===============================*/

.search-section{
    padding:80px 10%;
    text-align:center;
    background:#f8f8f8;
}

.search-section h2{
    font-size:40px;
    margin-bottom:30px;
    color:#222;
}

.search-box{
    max-width:700px;
    margin:auto;
    display:flex;
    overflow:hidden;
    border-radius:50px;
    box-shadow:0 10px 25px rgba(0,0,0,.1);
}

.search-box input{
    flex:1;
    border:none;
    padding:18px;
    font-size:17px;
    outline:none;
}

.search-box button{
    width:70px;
    border:none;
    background:#FFD700;
    cursor:pointer;
    font-size:20px;
}


/*==============================
 FEATURED PRODUCTS
===============================*/

.featured{
    padding:100px 10%;
    background:#fff;
}

.featured h2{
    text-align:center;
    font-size:42px;
    margin-bottom:60px;
}

.product-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:35px;
}

.card{
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 10px 25px rgba(0,0,0,.1);
    transition:.4s;
}

.card:hover{
    transform:translateY(-12px);
    box-shadow:0 20px 40px rgba(0,0,0,.2);
}

.card img{
    height:280px;
    object-fit:cover;
}

.card h3{
    font-size:25px;
    padding:20px;
}

.card p{
    padding:0 20px;
    color:#666;
    line-height:1.6;
}

.card h4{
    color:#FFD700;
    font-size:28px;
    padding:20px;
}

.card button{
    margin:20px;
    width:calc(100% - 40px);
    border:none;
    background:#111;
    color:#fff;
    padding:15px;
    border-radius:10px;
    cursor:pointer;
    transition:.3s;
}

.card button:hover{
    background:#FFD700;
    color:#111;
}


/*==============================
 ABOUT SECTION
===============================*/

.about{
    padding:100px 10%;
    background:#f5f5f5;
    text-align:center;
}

.about h2{
    font-size:42px;
    margin-bottom:25px;
}

.about p{
    max-width:900px;
    margin:auto;
    font-size:18px;
    line-height:2;
    color:#555;
}

.about .btn{
    display:inline-block;
    margin-top:40px;
}


/*==============================
 WHY CHOOSE US
===============================*/

.why-us{
    padding:100px 10%;
    background:#fff;
}

.why-us h2{
    text-align:center;
    font-size:42px;
    margin-bottom:60px;
}

.features{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:30px;
}

.feature{
    background:#fff;
    border-radius:20px;
    padding:40px 25px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.1);
    transition:.4s;
}

.feature:hover{
    background:#111;
    color:#fff;
    transform:translateY(-10px);
}

.feature i{
    font-size:50px;
    color:#FFD700;
    margin-bottom:20px;
}

.feature h3{
    margin-bottom:15px;
    font-size:24px;
}

.feature p{
    line-height:1.7;
    color:inherit;
}
/*==============================
 CUSTOMER REVIEWS
===============================*/

.reviews{
    padding:100px 10%;
    background:#f8f8f8;
}

.reviews h2{
    text-align:center;
    font-size:42px;
    margin-bottom:60px;
}

.review-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
    gap:30px;
}

.review{
    background:#fff;
    padding:35px;
    border-radius:20px;
    text-align:center;
    box-shadow:0 10px 25px rgba(0,0,0,.1);
    transition:.4s;
    font-size:20px;
}

.review:hover{
    transform:translateY(-10px);
    box-shadow:0 20px 40px rgba(0,0,0,.15);
}

.review p{
    margin:20px 0;
    color:#666;
    line-height:1.8;
}

.review h4{
    color:#FFD700;
}

/*==============================
 FAQ
===============================*/

.faq{
    padding:100px 10%;
    background:#fff;
}

.faq h2{
    text-align:center;
    font-size:42px;
    margin-bottom:50px;
}

.faq-item{
    max-width:900px;
    margin:25px auto;
    background:#f8f8f8;
    padding:25px;
    border-left:6px solid #FFD700;
    border-radius:10px;
    transition:.3s;
}

.faq-item:hover{
    background:#111;
    color:#fff;
}

.faq-item h3{
    margin-bottom:10px;
}

.faq-item p{
    line-height:1.8;
}

/*==============================
 NEWSLETTER
===============================*/

.newsletter{
    padding:100px 10%;
    text-align:center;
    background:#111;
    color:#fff;
}

.newsletter h2{
    font-size:42px;
    margin-bottom:20px;
}

.newsletter p{
    margin-bottom:35px;
    color:#ddd;
}

.newsletter form{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:15px;
}

.newsletter input{
    width:400px;
    max-width:100%;
    padding:16px;
    border:none;
    border-radius:40px;
    outline:none;
    font-size:16px;
}

.newsletter button{
    padding:16px 35px;
    border:none;
    background:#FFD700;
    color:#111;
    border-radius:40px;
    cursor:pointer;
    font-weight:600;
    transition:.3s;
}

.newsletter button:hover{
    transform:translateY(-5px);
}

/*==============================
 FOOTER
===============================*/

footer{
    background:#000;
    color:#fff;
    padding:70px 10%;
    text-align:center;
}

.footer-content h2{
    color:#FFD700;
    margin-bottom:20px;
}

.footer-content p{
    margin:15px 0;
    color:#ccc;
}

.socials{
    margin:30px 0;
}

.socials a{
    display:inline-flex;
    width:50px;
    height:50px;
    align-items:center;
    justify-content:center;
    background:#222;
    color:#FFD700;
    margin:0 10px;
    border-radius:50%;
    font-size:20px;
    transition:.3s;
}

.socials a:hover{
    background:#FFD700;
    color:#111;
    transform:translateY(-6px);
}

/*==============================
 SCROLL TO TOP
===============================*/

#topBtn{
    position:fixed;
    right:25px;
    bottom:25px;
    width:55px;
    height:55px;
    border:none;
    border-radius:50%;
    background:#FFD700;
    color:#111;
    font-size:22px;
    cursor:pointer;
    display:none;
    z-index:999;
    transition:.3s;
}

#topBtn:hover{
    transform:scale(1.1);
}

/*==============================
 ANIMATIONS
===============================*/

@keyframes slideIn{

    from{
        opacity:0;
        transform:translateY(-60px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }

}

.fade-up{
    animation:slideIn 1s ease;
}
/*==============================
 DARK MODE
===============================*/

body.dark-mode{
    background:#0d0d0d;
    color:#ffffff;
}

body.dark-mode header{
    background:#000;
}

body.dark-mode .featured,
body.dark-mode .why-us,
body.dark-mode .faq{
    background:#111;
}

body.dark-mode .about,
body.dark-mode .reviews{
    background:#1a1a1a;
}

body.dark-mode .card,
body.dark-mode .feature,
body.dark-mode .review,
body.dark-mode .faq-item{
    background:#222;
    color:#fff;
}

body.dark-mode .card p,
body.dark-mode .about p,
body.dark-mode .review p,
body.dark-mode .faq-item p{
    color:#ddd;
}

body.dark-mode .search-section{
    background:#111;
}

body.dark-mode .search-box input{
    background:#222;
    color:#fff;
}

body.dark-mode footer{
    background:#000;
}

/*==============================
 MOBILE MENU
===============================*/

@media(max-width:900px){

.nav-links{

position:fixed;

top:80px;

right:-100%;

width:260px;

height:100vh;

background:#111;

display:flex;

flex-direction:column;

align-items:center;

justify-content:flex-start;

padding-top:50px;

gap:35px;

transition:.4s;

}

.nav-links.active{

right:0;

}

.menu-btn{

display:block;

}

.slide-title{

font-size:45px;

}

.hero p{

font-size:17px;

}

.hero-buttons{

flex-direction:column;

}

.btn,

.btn-outline{

width:220px;

text-align:center;

}

}

/*==============================
 SMALL PHONES
===============================*/

@media(max-width:600px){

.navbar{

width:95%;

}

.logo a{

font-size:22px;

}

.slide-title{

font-size:34px;

}

.search-section h2,
.featured h2,
.about h2,
.why-us h2,
.reviews h2,
.faq h2,
.newsletter h2{

font-size:30px;

}

.product-grid{

grid-template-columns:1fr;

}

.features{

grid-template-columns:1fr;

}

.review-grid{

grid-template-columns:1fr;

}

.newsletter input{

width:100%;

}

.socials a{

width:45px;

height:45px;

margin:5px;

}

}

/*==============================
 HOVER EFFECTS
===============================*/

.card img{

transition:.5s;

}

.card:hover img{

transform:scale(1.08);

}

.logo{

transition:.3s;

}

.logo:hover{

transform:scale(1.05);

}

.nav-links a{

position:relative;

}

.nav-links a::after{

content:"";

position:absolute;

left:0;

bottom:-6px;

width:0;

height:2px;

background:#FFD700;

transition:.3s;

}

.nav-links a:hover::after{

width:100%;

}

/*==============================
 SCROLL BAR
===============================*/

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#111;

}

::-webkit-scrollbar-thumb{

background:#FFD700;

border-radius:10px;

}

::-webkit-scrollbar-thumb:hover{

background:#d4af37;

}

/*==============================
 SELECTION
===============================*/

::selection{

background:#FFD700;

color:#111;

}
