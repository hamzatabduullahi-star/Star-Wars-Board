/* ===================================
   STAR WARS GALAXY CREATIONS
   PREMIUM DARK THEME
=================================== */

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

:root{

--bg:#05070d;
--card:#111827;
--card2:#1b2535;
--gold:#d4af37;
--gold2:#f6d365;
--white:#ffffff;
--text:#d1d5db;
--border:rgba(255,255,255,.08);

}

body{

font-family:'Poppins',sans-serif;
background:var(--bg);
color:var(--white);
overflow-x:hidden;

}

/* Scrollbar */

::-webkit-scrollbar{

width:10px;

}

::-webkit-scrollbar-track{

background:#000;

}

::-webkit-scrollbar-thumb{

background:var(--gold);
border-radius:20px;

}

/* Container */

.container{

width:90%;
max-width:1300px;
margin:auto;

}

/* =====================
HEADER
===================== */

header{

position:fixed;
top:0;
left:0;
width:100%;
background:rgba(5,7,13,.95);
backdrop-filter:blur(15px);
z-index:999;
border-bottom:1px solid var(--border);

}

.header-inner{

display:flex;
justify-content:space-between;
align-items:center;
padding:18px 0;

}

.logo{

font-size:28px;
font-weight:800;
color:var(--gold);
text-decoration:none;

}

.logo span{

color:white;

}

/* Navigation */

nav{

display:flex;
align-items:center;
gap:30px;

}

nav a{

text-decoration:none;
color:white;
font-weight:500;
transition:.3s;

}

nav a:hover{

color:var(--gold);

}

nav a.active{

color:var(--gold);

}

/* Cart */

.cart-btn{

display:flex;
align-items:center;
gap:10px;
text-decoration:none;
color:white;
font-size:20px;
position:relative;

}

.cart-count{

position:absolute;
top:-8px;
right:-12px;
background:red;
color:white;
width:20px;
height:20px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
font-size:11px;

}

/* Mobile */

.menu-toggle{

display:none;
font-size:30px;
color:white;
background:none;
border:none;
cursor:pointer;

}

/* =====================
HERO
===================== */

.hero{

min-height:100vh;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding-top:120px;
background:
linear-gradient(rgba(0,0,0,.65),rgba(0,0,0,.8)),
url("images/banner.jpg");

background-size:cover;
background-position:center;

}

.hero-content{

max-width:800px;

}

.hero h1{

font-size:65px;
font-weight:800;
margin-bottom:20px;
color:var(--gold);

}

.hero p{

font-size:20px;
line-height:1.8;
color:var(--text);
margin-bottom:35px;

}

/* Buttons */

.btn{

display:inline-block;
padding:15px 35px;
background:var(--gold);
color:#000;
border-radius:50px;
text-decoration:none;
font-weight:700;
transition:.4s;

}

.btn:hover{

transform:translateY(-5px);
background:var(--gold2);

}

.btn-outline{

display:inline-block;
padding:15px 35px;
border:2px solid var(--gold);
border-radius:50px;
margin-left:15px;
text-decoration:none;
color:white;
transition:.4s;

}

.btn-outline:hover{

background:var(--gold);
color:#000;

}

/* =====================
SECTION
===================== */

.section{

padding:100px 0;

}

.section-title{

font-size:42px;
text-align:center;
margin-bottom:15px;
color:var(--gold);

}

.section-subtitle{

text-align:center;
color:var(--text);
margin-bottom:60px;

}
/* ===================================
   SEARCH BAR
=================================== */

.search-section{

padding:40px 0;

}

.search-box{

max-width:650px;
margin:0 auto;
display:flex;
background:var(--card);
border:1px solid var(--border);
border-radius:50px;
overflow:hidden;

}

.search-box input{

flex:1;
background:transparent;
border:none;
outline:none;
padding:18px 22px;
font-size:16px;
color:white;

}

.search-box input::placeholder{

color:#888;

}

.search-box button{

width:70px;
border:none;
background:var(--gold);
cursor:pointer;
font-size:20px;
transition:.3s;

}

.search-box button:hover{

background:var(--gold2);

}

/* ===================================
CATEGORY BUTTONS
=================================== */

.category-tabs{

display:flex;
justify-content:center;
gap:15px;
flex-wrap:wrap;
margin-bottom:50px;

}

.tab-btn{

padding:12px 28px;
background:var(--card);
border:1px solid var(--border);
border-radius:40px;
color:white;
cursor:pointer;
transition:.3s;
font-weight:600;

}

.tab-btn:hover,
.tab-btn.active{

background:var(--gold);
color:black;

}

/* ===================================
PRODUCT GRID
=================================== */

.product-grid{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;

}

.product-card{

background:var(--card);
border-radius:18px;
overflow:hidden;
transition:.4s;
border:1px solid var(--border);

}

.product-card:hover{

transform:translateY(-10px);
box-shadow:0 15px 35px rgba(0,0,0,.45);
border-color:var(--gold);

}

.product-card img,
.product-image{

width:100%;
height:260px;
object-fit:cover;
display:block;

}

.product-body{

padding:20px;

}

.product-body h3{

font-size:24px;
margin-bottom:10px;

}

.product-body p{

color:var(--text);
line-height:1.7;
margin-bottom:15px;

}

.rating{

color:gold;
font-size:18px;
margin-bottom:15px;

}

.price{

font-size:30px;
font-weight:700;
color:var(--gold);
margin-bottom:20px;

}

.product-body .btn{

width:100%;
text-align:center;

}

/* ===================================
ABOUT SECTION
=================================== */

.about{

padding:100px 0;

}

.about .container{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
gap:60px;
align-items:center;

}

.about img{

width:100%;
border-radius:20px;

}

.about h2{

font-size:42px;
margin-bottom:20px;
color:var(--gold);

}

.about p{

font-size:17px;
line-height:1.9;
color:var(--text);

}

/* ===================================
WHY CHOOSE US
=================================== */

.features{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
gap:25px;
margin-top:50px;

}

.feature{

background:var(--card);
padding:30px;
border-radius:18px;
text-align:center;
transition:.4s;
border:1px solid var(--border);

}

.feature:hover{

transform:translateY(-8px);
border-color:var(--gold);

}

.feature i{

font-size:45px;
color:var(--gold);
margin-bottom:20px;

}

.feature h3{

margin-bottom:15px;

}

.feature p{

color:var(--text);
line-height:1.7;

}
/* ===================================
CUSTOMER REVIEWS
=================================== */

.reviews{

padding:100px 0;

}

.review-grid{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:30px;

}

.review{

background:var(--card);
padding:30px;
border-radius:20px;
border:1px solid var(--border);
transition:.4s;

}

.review:hover{

transform:translateY(-8px);
border-color:var(--gold);

}

.review p{

margin:20px 0;
line-height:1.8;
color:var(--text);

}

.review h4{

color:var(--gold);

}

/* ===================================
NEWSLETTER
=================================== */

.newsletter{

padding:90px 0;
text-align:center;

}

.newsletter form{

max-width:650px;
margin:40px auto;
display:flex;
overflow:hidden;
border-radius:50px;
background:var(--card);

}

.newsletter input{

flex:1;
padding:18px;
border:none;
outline:none;
background:transparent;
color:white;
font-size:16px;

}

.newsletter button{

padding:18px 35px;
border:none;
background:var(--gold);
font-weight:700;
cursor:pointer;
transition:.3s;

}

.newsletter button:hover{

background:var(--gold2);

}

/* ===================================
CONTACT PAGE
=================================== */

.contact-grid{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(350px,1fr));
gap:40px;

}

.contact-card{

background:var(--card);
padding:35px;
border-radius:18px;
border:1px solid var(--border);

}

.contact-card h3{

margin-bottom:20px;
color:var(--gold);

}

.contact-card label{

display:block;
margin-top:15px;
margin-bottom:8px;
font-weight:600;

}

.contact-card input,
.contact-card textarea,
.contact-card select{

width:100%;
padding:15px;
background:#0d1117;
border:1px solid var(--border);
border-radius:10px;
color:white;
outline:none;
font-size:15px;

}

.contact-card textarea{

resize:vertical;

}

.contact-card input:focus,
.contact-card textarea:focus{

border-color:var(--gold);

}

/* ===================================
CART
=================================== */

.cart-page{

padding-top:120px;

}

.cart-table{

width:100%;
border-collapse:collapse;
background:var(--card);
border-radius:15px;
overflow:hidden;

}

.cart-table th{

background:var(--gold);
color:black;
padding:18px;

}

.cart-table td{

padding:20px;
border-bottom:1px solid var(--border);

}

.cart-table img{

width:80px;
border-radius:10px;

}

.qty-controls{

display:flex;
align-items:center;
gap:10px;

}

.qty-btn{

width:35px;
height:35px;
border:none;
background:var(--gold);
cursor:pointer;
font-size:18px;
font-weight:bold;
border-radius:8px;

}

.remove-item{

background:#d32f2f;
color:white;
border:none;
padding:10px 18px;
border-radius:8px;
cursor:pointer;

}

.cart-summary{

margin-top:40px;
background:var(--card);
padding:30px;
border-radius:18px;
border:1px solid var(--border);

}

.cart-total-row{

display:flex;
justify-content:space-between;
font-size:24px;
margin-bottom:25px;

}

.checkout-btn{

display:block;
width:100%;
padding:18px;
background:var(--gold);
color:black;
text-align:center;
text-decoration:none;
font-weight:700;
border:none;
border-radius:12px;
cursor:pointer;
transition:.3s;

}

.checkout-btn:hover{

background:var(--gold2);

}

/* ===================================
CHECKOUT
=================================== */

.checkout-grid{

display:grid;
grid-template-columns:2fr 1fr;
gap:40px;
align-items:start;

}

.checkout-item{

padding:15px 0;
border-bottom:1px solid var(--border);

}

.checkout-item img{

border-radius:10px;

}

/* ===================================
FOOTER
=================================== */

footer{

margin-top:100px;
padding:60px 0;
background:#000;
text-align:center;
border-top:1px solid var(--border);

}

footer h2{

color:var(--gold);
margin-bottom:20px;

}

footer p{

color:var(--text);
margin-top:10px;

}

.social-icons{

display:flex;
justify-content:center;
gap:20px;
margin:25px 0;

}

.social-icons a{

width:50px;
height:50px;
background:var(--card);
border-radius:50%;
display:flex;
justify-content:center;
align-items:center;
text-decoration:none;
color:white;
font-size:20px;
transition:.3s;

}

.social-icons a:hover{

background:var(--gold);
color:black;

}
/* ===================================
BACK TO TOP BUTTON
=================================== */

#topBtn{

position:fixed;
right:25px;
bottom:25px;
width:55px;
height:55px;
border:none;
border-radius:50%;
background:var(--gold);
color:#000;
font-size:22px;
cursor:pointer;
display:flex;
align-items:center;
justify-content:center;
box-shadow:0 10px 25px rgba(0,0,0,.35);
transition:.35s;
z-index:999;

}

#topBtn:hover{

transform:translateY(-6px);
background:var(--gold2);

}

/* ===================================
SLIDING WEBSITE TITLE
=================================== */

.slide-title{

display:inline-block;
animation:slideText 8s linear infinite;

}

@keyframes slideText{

0%{

transform:translateX(-120%);

}

50%{

transform:translateX(0);

}

100%{

transform:translateX(120%);

}

}

/* ===================================
FADE ANIMATION
=================================== */

.fade{

animation:fade .8s ease;

}

@keyframes fade{

from{

opacity:0;
transform:translateY(30px);

}

to{

opacity:1;
transform:translateY(0);

}

}

/* ===================================
HOVER EFFECTS
=================================== */

img{

transition:.4s;

}

.product-card:hover img{

transform:scale(1.06);

}

.feature:hover i{

transform:rotate(8deg) scale(1.1);

}

/* ===================================
SMOOTH LINKS
=================================== */

a{

transition:.3s;

}

/* ===================================
DARK MODE SUPPORT
=================================== */

body.light{

--bg:#f5f5f5;
--card:#ffffff;
--card2:#eeeeee;
--white:#111111;
--text:#444444;
--border:#dddddd;

background:var(--bg);
color:var(--white);

}

body.light footer{

background:#ffffff;

}

body.light .contact-card input,
body.light .contact-card textarea,
body.light .search-box,
body.light .newsletter form{

background:#f2f2f2;
color:#111;

}

/* ===================================
RESPONSIVE TABLETS
=================================== */

@media(max-width:992px){

.hero h1{

font-size:48px;

}

.checkout-grid{

grid-template-columns:1fr;

}

.header-inner{

flex-wrap:wrap;

}

}

/* ===================================
RESPONSIVE MOBILE
=================================== */

@media(max-width:768px){

.menu-toggle{

display:block;

}

nav{

display:none;
width:100%;
flex-direction:column;
background:var(--card);
margin-top:20px;
padding:20px;
border-radius:15px;

}

nav.active{

display:flex;

}

.hero{

padding:150px 20px 80px;

}

.hero h1{

font-size:36px;

}

.hero p{

font-size:16px;

}

.btn,
.btn-outline{

display:block;
width:100%;
margin:10px 0;
text-align:center;

}

.section{

padding:70px 0;

}

.section-title{

font-size:32px;

}

.product-grid{

grid-template-columns:1fr;

}

.features{

grid-template-columns:1fr;

}

.review-grid{

grid-template-columns:1fr;

}

.contact-grid{

grid-template-columns:1fr;

}

.cart-table{

display:block;
overflow-x:auto;

}

.newsletter form{

flex-direction:column;
border-radius:15px;

}

.newsletter button{

width:100%;

}

}

/* ===================================
EXTRA SMALL DEVICES
=================================== */

@media(max-width:480px){

.logo{

font-size:22px;

}

.hero h1{

font-size:30px;

}

.hero p{

font-size:15px;

}

.section-title{

font-size:28px;

}

.price{

font-size:24px;

}

}

/* ===================================
END OF CSS
=================================== */
