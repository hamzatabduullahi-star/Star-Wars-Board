/* ===================================
   STAR WARS GALAXY CREATIONS
   PREMIUM DARK THEME WITH SPACE BACKGROUND
=================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

:root {
    --bg-primary: #05070d;
    --bg-secondary: #0a0f1a;
    --bg-card: rgba(17, 24, 39, 0.85);
    --bg-card2: rgba(27, 37, 53, 0.7);
    --gold: #d4af37;
    --gold2: #f6d365;
    --gold-glow: rgba(212, 175, 55, 0.25);
    --white: #ffffff;
    --text: #d1d5db;
    --text-muted: #8892a0;
    --border: rgba(255, 255, 255, 0.08);
    --shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg-primary);
    color: var(--white);
    overflow-x: hidden;
    min-height: 100vh;
    /* === DEEP SPACE BACKGROUND === */
    background-image: 
        /* Nebula glow */
        radial-gradient(ellipse at 20% 50%, rgba(40, 60, 120, 0.25) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(80, 40, 80, 0.2) 0%, transparent 50%),
        radial-gradient(ellipse at 50% 80%, rgba(20, 60, 100, 0.15) 0%, transparent 50%),
        /* Starfield pattern */
        url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" opacity="0.4"><circle cx="20" cy="30" r="1.5" fill="white"/><circle cx="50" cy="10" r="1" fill="white"/><circle cx="80" cy="50" r="2" fill="white"/><circle cx="120" cy="20" r="1.2" fill="white"/><circle cx="160" cy="40" r="1.8" fill="white"/><circle cx="180" cy="80" r="1" fill="white"/><circle cx="10" cy="80" r="2.2" fill="white"/><circle cx="40" cy="100" r="1.5" fill="white"/><circle cx="70" cy="130" r="1" fill="white"/><circle cx="100" cy="160" r="2" fill="white"/><circle cx="130" cy="180" r="1.3" fill="white"/><circle cx="170" cy="150" r="1.7" fill="white"/><circle cx="190" cy="120" r="1" fill="white"/><circle cx="30" cy="170" r="1.5" fill="white"/><circle cx="90" cy="90" r="1.2" fill="white"/><circle cx="150" cy="100" r="2.5" fill="white"/><circle cx="60" cy="60" r="0.8" fill="white"/><circle cx="110" cy="110" r="1.1" fill="white"/></svg>');
    background-size: cover, cover, 300px 300px;
    background-blend-mode: normal, normal, overlay;
}

/* Scrollbar */
::-webkit-scrollbar {
    width: 10px;
}
::-webkit-scrollbar-track {
    background: #000;
}
::-webkit-scrollbar-thumb {
    background: var(--gold);
    border-radius: 20px;
    box-shadow: 0 0 20px var(--gold-glow);
}

/* Container */
.container {
    width: 90%;
    max-width: 1300px;
    margin: auto;
}

/* ===================================
   GLASS-MORPHISM CARDS (UNIVERSAL)
=================================== */
.glass-card {
    background: var(--bg-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--border);
    border-radius: 18px;
    padding: 30px;
    box-shadow: var(--shadow);
    transition: 0.4s;
}
.glass-card:hover {
    border-color: var(--gold);
    box-shadow: 0 8px 40px rgba(212, 175, 55, 0.12);
}

/* ===================================
   HEADER
=================================== */
header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: rgba(5, 7, 13, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    z-index: 999;
    border-bottom: 1px solid var(--border);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
}

.header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
}

.logo {
    font-size: 28px;
    font-weight: 800;
    color: var(--gold);
    text-decoration: none;
    text-shadow: 0 0 30px var(--gold-glow);
}
.logo span {
    color: white;
}

/* Navigation */
nav {
    display: flex;
    align-items: center;
    gap: 30px;
}
nav a {
    text-decoration: none;
    color: white;
    font-weight: 500;
    transition: 0.3s;
    position: relative;
}
nav a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: 0.3s;
    box-shadow: 0 0 12px var(--gold-glow);
}
nav a:hover::after,
nav a.active::after {
    width: 100%;
}
nav a:hover,
nav a.active {
    color: var(--gold);
}

.cart-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: white;
    font-size: 20px;
    position: relative;
}
.cart-count {
    position: absolute;
    top: -8px;
    right: -12px;
    background: #e63946;
    color: white;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    font-weight: 700;
    box-shadow: 0 0 15px rgba(230, 57, 70, 0.4);
}

.menu-toggle {
    display: none;
    font-size: 30px;
    color: white;
    background: none;
    border: none;
    cursor: pointer;
}

/* ===================================
   HERO
=================================== */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding-top: 120px;
    background:
        radial-gradient(ellipse at center, rgba(0, 0, 0, 0.5) 0%, rgba(5, 7, 13, 0.85) 100%),
        url("images/banner.jpg");
    background-size: cover;
    background-position: center;
    background-blend-mode: overlay;
    border-bottom: 1px solid var(--border);
}

.hero-content {
    max-width: 800px;
}
.hero h1 {
    font-size: 65px;
    font-weight: 800;
    margin-bottom: 20px;
    color: var(--gold);
    text-shadow: 0 0 60px var(--gold-glow);
}
.hero p {
    font-size: 20px;
    line-height: 1.8;
    color: var(--text);
    margin-bottom: 35px;
}

/* ===================================
   BUTTONS
=================================== */
.btn {
    display: inline-block;
    padding: 15px 35px;
    background: var(--gold);
    color: #000;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 700;
    transition: 0.4s;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 25px var(--gold-glow);
}
.btn:hover {
    transform: translateY(-5px);
    background: var(--gold2);
    box-shadow: 0 0 40px var(--gold-glow);
}

.btn-outline {
    display: inline-block;
    padding: 15px 35px;
    border: 2px solid var(--gold);
    border-radius: 50px;
    margin-left: 15px;
    text-decoration: none;
    color: white;
    transition: 0.4s;
}
.btn-outline:hover {
    background: var(--gold);
    color: #000;
    box-shadow: 0 0 30px var(--gold-glow);
}

/* ===================================
   SECTIONS
=================================== */
.section {
    padding: 100px 0;
}
.section-title {
    font-size: 42px;
    text-align: center;
    margin-bottom: 15px;
    color: var(--gold);
    text-shadow: 0 0 30px var(--gold-glow);
}
.section-subtitle {
    text-align: center;
    color: var(--text-muted);
    margin-bottom: 60px;
}

/* ===================================
   SEARCH BAR
=================================== */
.search-section {
    padding: 40px 0;
}
.search-box {
    max-width: 650px;
    margin: 0 auto;
    display: flex;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 50px;
    overflow: hidden;
    backdrop-filter: blur(8px);
}
.search-box input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 18px 22px;
    font-size: 16px;
    color: white;
}
.search-box input::placeholder {
    color: #666;
}
.search-box button {
    width: 70px;
    border: none;
    background: var(--gold);
    cursor: pointer;
    font-size: 20px;
    transition: 0.3s;
}
.search-box button:hover {
    background: var(--gold2);
}

/* ===================================
   CATEGORY TABS
=================================== */
.category-tabs {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-bottom: 50px;
}
.tab-btn {
    padding: 12px 28px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 40px;
    color: white;
    cursor: pointer;
    transition: 0.3s;
    font-weight: 600;
    backdrop-filter: blur(4px);
}
.tab-btn:hover,
.tab-btn.active {
    background: var(--gold);
    color: black;
    box-shadow: 0 0 25px var(--gold-glow);
}

/* ===================================
   PRODUCT GRID
=================================== */
.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
}
.product-card {
    background: var(--bg-card);
    border-radius: 18px;
    overflow: hidden;
    transition: 0.4s;
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
}
.product-card:hover {
    transform: translateY(-10px);
    border-color: var(--gold);
    box-shadow: 0 15px 45px rgba(212, 175, 55, 0.15);
}
.product-card img,
.product-image {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
}
.product-body {
    padding: 20px;
}
.product-body h3 {
    font-size: 24px;
    margin-bottom: 10px;
}
.product-body p {
    color: var(--text);
    line-height: 1.7;
    margin-bottom: 15px;
}
.rating {
    color: gold;
    font-size: 18px;
    margin-bottom: 15px;
}
.price {
    font-size: 30px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 20px;
}
.product-body .btn {
    width: 100%;
    text-align: center;
}

/* ===================================
   ABOUT SECTION
=================================== */
.about {
    padding: 100px 0;
}
.about .container {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 60px;
    align-items: center;
}
.about img {
    width: 100%;
    border-radius: 20px;
    box-shadow: var(--shadow);
    border: 1px solid var(--border);
}
.about h2 {
    font-size: 42px;
    margin-bottom: 20px;
    color: var(--gold);
    text-shadow: 0 0 30px var(--gold-glow);
}
.about p {
    font-size: 17px;
    line-height: 1.9;
    color: var(--text);
}

/* ===================================
   FEATURES
=================================== */
.features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 25px;
    margin-top: 50px;
}
.feature {
    background: var(--bg-card);
    padding: 30px;
    border-radius: 18px;
    text-align: center;
    transition: 0.4s;
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
}
.feature:hover {
    transform: translateY(-8px);
    border-color: var(--gold);
    box-shadow: 0 8px 35px rgba(212, 175, 55, 0.12);
}
.feature i {
    font-size: 45px;
    color: var(--gold);
    margin-bottom: 20px;
}
.feature h3 {
    margin-bottom: 15px;
}
.feature p {
    color: var(--text);
    line-height: 1.7;
}

/* ===================================
   REVIEWS
=================================== */
.reviews {
    padding: 100px 0;
}
.review-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
}
.review {
    background: var(--bg-card);
    padding: 30px;
    border-radius: 20px;
    border: 1px solid var(--border);
    transition: 0.4s;
    backdrop-filter: blur(8px);
}
.review:hover {
    transform: translateY(-8px);
    border-color: var(--gold);
    box-shadow: 0 8px 35px rgba(212, 175, 55, 0.12);
}
.review p {
    margin: 20px 0;
    line-height: 1.8;
    color: var(--text);
}
.review h4 {
    color: var(--gold);
}

/* ===================================
   NEWSLETTER
=================================== */
.newsletter {
    padding: 90px 0;
    text-align: center;
}
.newsletter form {
    max-width: 650px;
    margin: 40px auto;
    display: flex;
    overflow: hidden;
    border-radius: 50px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
}
.newsletter input {
    flex: 1;
    padding: 18px;
    border: none;
    outline: none;
    background: transparent;
    color: white;
    font-size: 16px;
}
.newsletter button {
    padding: 18px 35px;
    border: none;
    background: var(--gold);
    font-weight: 700;
    cursor: pointer;
    transition: 0.3s;
}
.newsletter button:hover {
    background: var(--gold2);
}

/* ===================================
   CONTACT PAGE
=================================== */
.contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 40px;
}
.contact-card {
    background: var(--bg-card);
    padding: 35px;
    border-radius: 18px;
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
}
.contact-card h3 {
    margin-bottom: 20px;
    color: var(--gold);
}
.contact-card label {
    display: block;
    margin-top: 15px;
    margin-bottom: 8px;
    font-weight: 600;
}
.contact-card input,
.contact-card textarea,
.contact-card select {
    width: 100%;
    padding: 15px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: white;
    outline: none;
    font-size: 15px;
    transition: 0.3s;
}
.contact-card textarea {
    resize: vertical;
}
.contact-card input:focus,
.contact-card textarea:focus {
    border-color: var(--gold);
    box-shadow: 0 0 20px var(--gold-glow);
}

/* ===================================
   CART PAGE
=================================== */
.cart-page {
    padding-top: 120px;
}
.cart-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-card);
    border-radius: 15px;
    overflow: hidden;
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
}
.cart-table th {
    background: var(--gold);
    color: black;
    padding: 18px;
}
.cart-table td {
    padding: 20px;
    border-bottom: 1px solid var(--border);
}
.cart-table img {
    width: 80px;
    border-radius: 10px;
}
.qty-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}
.qty-btn {
    width: 35px;
    height: 35px;
    border: none;
    background: var(--gold);
    cursor: pointer;
    font-size: 18px;
    font-weight: bold;
    border-radius: 8px;
    transition: 0.3s;
}
.qty-btn:hover {
    background: var(--gold2);
    transform: scale(1.05);
}
.remove-item {
    background: #d32f2f;
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 8px;
    cursor: pointer;
    transition: 0.3s;
}
.remove-item:hover {
    background: #ff1744;
    box-shadow: 0 0 25px rgba(255, 23, 68, 0.3);
}

.cart-summary {
    margin-top: 40px;
    background: var(--bg-card);
    padding: 30px;
    border-radius: 18px;
    border: 1px solid var(--border);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow);
}
.cart-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 24px;
    margin-bottom: 25px;
}
.checkout-btn {
    display: block;
    width: 100%;
    padding: 18px;
    background: var(--gold);
    color: black;
    text-align: center;
    text-decoration: none;
    font-weight: 700;
    border: none;
    border-radius: 12px;
    cursor: pointer;
    transition: 0.3s;
    box-shadow: 0 0 30px var(--gold-glow);
}
.checkout-btn:hover {
    background: var(--gold2);
    transform: translateY(-3px);
}

/* ===================================
   CHECKOUT PAGE
=================================== */
.checkout-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
    align-items: start;
}
.checkout-item {
    padding: 15px 0;
    border-bottom: 1px solid var(--border);
}
.checkout-item img {
    border-radius: 10px;
}

/* ===================================
   FOOTER
=================================== */
footer {
    margin-top: 100px;
    padding: 60px 0;
    background: rgba(0, 0, 0, 0.9);
    text-align: center;
    border-top: 1px solid var(--border);
    backdrop-filter: blur(10px);
}
footer h2 {
    color: var(--gold);
    margin-bottom: 20px;
    text-shadow: 0 0 30px var(--gold-glow);
}
footer p {
    color: var(--text-muted);
    margin-top: 10px;
}
.social-icons {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin: 25px 0;
}
.social-icons a {
    width: 50px;
    height: 50px;
    background: var(--bg-card);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    text-decoration: none;
    color: white;
    font-size: 20px;
    transition: 0.3s;
    border: 1px solid var(--border);
}
.social-icons a:hover {
    background: var(--gold);
    color: black;
    box-shadow: 0 0 30px var(--gold-glow);
    transform: translateY(-5px);
}

/* ===================================
   BACK TO TOP
=================================== */
#topBtn {
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 55px;
    height: 55px;
    border: none;
    border-radius: 50%;
    background: var(--gold);
    color: #000;
    font-size: 22px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3);
    transition: 0.35s;
    z-index: 999;
}
#topBtn:hover {
    transform: translateY(-6px);
    background: var(--gold2);
    box-shadow: 0 10px 40px rgba(212, 175, 55, 0.5);
}

/* ===================================
   ANIMATIONS
=================================== */
.slide-title {
    display: inline-block;
    animation: slideText 8s linear infinite;
}
@keyframes slideText {
    0% { transform: translateX(-120%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(120%); }
}

.fade {
    animation: fade 0.8s ease;
}
@keyframes fade {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Hover effects */
img {
    transition: 0.4s;
}
.product-card:hover img {
    transform: scale(1.06);
}
.feature:hover i {
    transform: rotate(8deg) scale(1.1);
}
a {
    transition: 0.3s;
}

/* ===================================
   LIGHT MODE
=================================== */
body.light {
    --bg-primary: #f0f2f5;
    --bg-secondary: #e8eaed;
    --bg-card: rgba(255, 255, 255, 0.85);
    --white: #111111;
    --text: #444444;
    --text-muted: #666666;
    --border: rgba(0, 0, 0, 0.1);
    background-image: 
        radial-gradient(ellipse at 20% 50%, rgba(200, 180, 100, 0.1) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 20%, rgba(180, 150, 100, 0.08) 0%, transparent 50%);
    background-size: cover, cover;
}
body.light footer {
    background: rgba(255, 255, 255, 0.95);
}
body.light .contact-card input,
body.light .contact-card textarea,
body.light .search-box,
body.light .newsletter form {
    background: rgba(0, 0, 0, 0.05);
    color: #111;
}
body.light .glass-card {
    background: rgba(255, 255, 255, 0.7);
}

/* ===================================
   RESPONSIVE
=================================== */
@media (max-width: 992px) {
    .hero h1 { font-size: 48px; }
    .checkout-grid { grid-template-columns: 1fr; }
    .header-inner { flex-wrap: wrap; }
}

@media (max-width: 768px) {
    .menu-toggle { display: block; }
    nav {
        display: none;
        width: 100%;
        flex-direction: column;
        background: var(--bg-card);
        margin-top: 20px;
        padding: 20px;
        border-radius: 15px;
        backdrop-filter: blur(12px);
    }
    nav.active { display: flex; }
    .hero {
        padding: 150px 20px 80px;
    }
    .hero h1 { font-size: 36px; }
    .hero p { font-size: 16px; }
    .btn,
    .btn-outline {
        display: block;
        width: 100%;
        margin: 10px 0;
        text-align: center;
    }
    .section { padding: 70px 0; }
    .section-title { font-size: 32px; }
    .product-grid { grid-template-columns: 1fr; }
    .features { grid-template-columns: 1fr; }
    .review-grid { grid-template-columns: 1fr; }
    .contact-grid { grid-template-columns: 1fr; }
    .cart-table { display: block; overflow-x: auto; }
    .newsletter form {
        flex-direction: column;
        border-radius: 15px;
    }
    .newsletter button { width: 100%; }
}

@media (max-width: 480px) {
    .logo { font-size: 22px; }
    .hero h1 { font-size: 30px; }
    .hero p { font-size: 15px; }
    .section-title { font-size: 28px; }
    .price { font-size: 24px; }
}

/* ===================================
   END OF CSS
=================================== */
